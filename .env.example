# Primitive (required for live two-laptop demo)
PRIMITIVE_API_KEY=prim_...
PRIMITIVE_WEBHOOK_SECRET=whsec_...
PRIMITIVE_FROM=agent@your-subdomain.primitive.email

# Pin webhook port so tunnel URL stays stable across restarts
GBRAIN_WEBHOOK_PORT=8080

# GBrain API (optional — use demo_gbrain + profile.json or local gbrain instead)
GBRAIN_API_KEY=demo_gbrain

# Claude matching (strongly recommended for demo-quality scores)
ANTHROPIC_API_KEY=sk-ant-...

# After setting env, expose webhook (each laptop needs its own tunnel + Primitive dashboard URL):
#   cloudflared tunnel --url http://localhost:8080
# Dashboard → Webhooks → https://<tunnel-host>/webhooks/email
